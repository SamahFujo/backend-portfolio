# =========================
# Django core
# =========================
DJANGO_ENV=production
SECRET_KEY=replace-me
DEBUG=False
ALLOWED_HOSTS=your-backend-domain.com,www.your-backend-domain.com

# =========================
# Database
# =========================
DB_NAME=replace-me
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432

# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# =========================
# Admin security
# =========================
ADMIN_API_KEY=replace-me

# =========================
# Frontend / browser origins
# =========================
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# =========================
# Email / Resend
# =========================
RESEND_API_KEY=replace-me
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=replace-me

CONTACT_TO_EMAIL=replace-me
CONTACT_FROM_EMAIL=onboarding@resend.dev

# =========================
# Embeddings / retrieval
# =========================
JINA_API_KEY=replace-me
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=jina

RERANK_MIN_SCORE=0.20
RERANK_CANDIDATE_K=40
RERANK_TOP_N=8

# =========================
# Gemini API keys
# =========================
GEMINI_REWRITE_API_KEY=replace-me
GEMINI_GROUNDED_API_KEY=replace-me

# =========================
# DeepSeek API keys
# =========================
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=replace-me

# =========================
# LLM settings
# =========================
LLM_HTTP_TIMEOUT=60
GROUNDED_PRIMARY_MODEL=gemini-2.5-flash-lite
GROUNDED_SECONDARY_MODEL=deepseek-chat
GROUNDED_GEMINI_MAX_RETRIES=3


# =========================
# HTTPS security
# =========================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Enable HSTS only after HTTPS is stable for your domain
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True


# =========================
# Storage Bucket - media
# =========================
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=samah-ai-media-prod
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_CUSTOM_DOMAIN=
USE_S3_MEDIA=True